# Personal Assistant - environment configuration
# Copy this file to `.env` (setup.sh does this on first run) and fill in your values.
# `.env` is git-ignored; never commit real secrets.

# Local model servers (bound to 127.0.0.1 on this same host)
# Full endpoint URLs are required - the app posts to these paths verbatim.
WHISPER_URL=http://127.0.0.1:8081/inference
SLM_URL=http://127.0.0.1:8080/v1/chat/completions

# Home Assistant
HA_URL=http://127.0.0.1:8123
HA_TOKEN=REPLACE_WITH_YOUR_LONG_LIVED_ACCESS_TOKEN

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional TTS output-device name fragment; leave unset to use the system default.
PIPER_OUTPUT_DEVICE=
