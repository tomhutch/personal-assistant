# Personal Assistant - environment configuration
# Copy this file to `.env` (setup.sh does this on first run) and fill in your values.
# `.env` is git-ignored; never commit real secrets.

# Local model servers (bound to 127.0.0.1 on this same host)
# Full endpoint URLs are required - the app posts to these paths verbatim.
WHISPER_URL=http://127.0.0.1:8081/inference
SLM_URL=http://127.0.0.1:8080/v1/chat/completions

# Home Assistant
HA_URL=http://127.0.0.1:8123
HA_TOKEN=REPLACE_WITH_YOUR_LONG_LIVED_ACCESS_TOKEN

# Spotify catalog search (optional). Used when Home Assistant can't search media itself,
# e.g. "play Taylor Swift on Sonos". Create an app at https://developer.spotify.com/dashboard.
# Playback itself is done by the Home Assistant media player, so no user login is needed.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Use local HassIL intent matching by default; set false to use the SLM parser.
USE_DETERMINISTIC_INTENT=true

# Optional TTS output-device name fragment; leave unset to use the system default.
PIPER_OUTPUT_DEVICE=
