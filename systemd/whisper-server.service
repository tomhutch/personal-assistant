[Unit]
Description=Whisper Server (whisper.cpp)
After=network.target

[Service]
User=%%DEPLOY_USER%%
WorkingDirectory=%%BASE_DIR%%/whisper.cpp
ExecStart=%%BASE_DIR%%/whisper.cpp/build/bin/whisper-server \
  -m %%BASE_DIR%%/whisper.cpp/models/ggml-base.en.bin \
  --port 8081 \
  --host 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target