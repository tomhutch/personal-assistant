[Unit]
Description=Llama Server (Qwen 2.5 SLM)
After=network.target

[Service]
User=%%DEPLOY_USER%%
WorkingDirectory=%%BASE_DIR%%/models
ExecStart=/usr/local/bin/llama-server \
  -m %%BASE_DIR%%/models/%%QWEN_MODEL%% \
  -ngl 99 \
  --port 8080 \
  --ctx-size 2048 \
  -fa on \
  --cache-prompt \
  --cache-reuse 256 \
  --host 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target