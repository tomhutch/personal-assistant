[Unit]
Description=Llama Server (Qwen 2.5 3B SLM)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/personal-assistant/models
ExecStart=/usr/local/bin/llama-server \
  -m /home/ubuntu/personal-assistant/models/qwen2.5-3b-instruct-q4_k_m.gguf \
  --port 8080 \
  --ctx-size 2048 \
  -fa on \
  --cache-prompt \
  --cache-reuse 256 \
  --host 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
